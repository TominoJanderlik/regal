{
  "manifest_version": 3,
  "name": "Regál – kde je zásielka",
  "short_name": "Regál",
  "version": "1.3.0",
  "description": "Na stránke Balíkova ukáže vpravo dole, kde je zásielka uložená (sektor, stôl, Allegro) podľa evidencie Regál.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Regál",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://pudvswjifctcskujrzlr.supabase.co/*",
    "https://ps.sps-sro.sk/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "minimum_chrome_version": "110",
  "content_scripts": [
    {
      "matches": [
        "https://ps.sps-sro.sk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}